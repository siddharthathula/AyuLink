#include <Adafruit_GFX.h>
#include <Adafruit_SH110X.h>
#include <Arduino.h>
#include <ArduinoJson.h>
#include <DHT.h>
#include <LoRa.h>
#include <SPI.h>
#include <WebSocketsClient.h> // We use WebSocketsClient for Gateway -> Backend
#include <WiFi.h>
